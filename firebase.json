{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.py",
      "*.bat",
      "DIMORA STELLA"
    ],
    "rewrites": [
      { "source": "/api/send-whatsapp", "function": "sendWhatsapp" },
      { "source": "/api/ical-sync",     "function": "icalSync"     },
      { "source": "/admin",             "destination": "/gestionale.html" }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
