# ─────────────────────────────────────────────────────────────────
# Copia questo file in functions/.env e compila i valori reali.
# NON committare functions/.env — è già in .gitignore.
# ─────────────────────────────────────────────────────────────────

# WhatsApp Business API (Meta Cloud API)
# Ottieni da: business.facebook.com → WhatsApp → Configurazione API
WA_TOKEN=il_tuo_token_permanente
WA_PHONE_ID=il_tuo_phone_number_id

# iCal Airbnb
# Airbnb → Struttura → Calendario → Disponibilità → Esporta calendario
ICAL_AIRBNB=https://www.airbnb.it/calendar/ical/XXXXXXX.ics?s=XXXXXXX

# iCal Booking.com
# Booking.com → Struttura → Disponibilità → Sincronizzazione iCal → Esporta
ICAL_BOOKING=https://admin.booking.com/hotel/hoteladmin/ical.html?t=XXXXXXX
